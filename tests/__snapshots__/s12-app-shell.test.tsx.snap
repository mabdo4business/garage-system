exports[`S12 — staff app shell > renders the shell in ar with catalog labels, the global search and a same-page language link 1`] = `"<html lang="ar" dir="rtl"><head></head><body><div class="shell"><nav class="shell-nav" aria-label="القائمة الرئيسية"><div class="shell-brand">نظام إدارة الورشة</div><ul><li><a href="/ar">اليوم</a></li><li><a href="/ar/repair-orders">أوامر الإصلاح</a></li><li><a href="/ar/workshop">الورشة</a></li><li><a href="/ar/search" aria-current="page">العملاء والمركبات</a></li><li><a href="/ar/catalogue">قائمة الأسعار</a></li></ul></nav><div class="shell-main"><header class="shell-topbar"><form class="topbar-search" role="search" action="/ar/search" method="get"><label for="shell-search" class="visually-hidden">البحث عن العملاء والمركبات</label><input id="shell-search" type="search" placeholder="رقم اللوحة أو الهاتف أو الاسم أو رقم الهيكل" dir="auto" name="q"/><button type="submit" class="btn btn-secondary">بحث</button></form><div class="topbar-user"><span class="who"><span>Sara Test</span><small>مستشار خدمة</small></span><a class="btn btn-quiet" href="/en/vehicles/abc" hrefLang="en" lang="en">English</a><form action="/api/auth/logout" method="post"><input type="hidden" name="locale" value="ar"/><button type="submit" class="btn btn-quiet">تسجيل الخروج</button></form></div></header><main class="shell-content"><p>page</p></main></div></div></body></html>"`;

exports[`S12 — staff app shell > renders the shell in en with catalog labels, the global search and a same-page language link 1`] = `"<html lang="en" dir="ltr"><head></head><body><div class="shell"><nav class="shell-nav" aria-label="Main menu"><div class="shell-brand">Garage Management System</div><ul><li><a href="/en">Today</a></li><li><a href="/en/repair-orders">Repair orders</a></li><li><a href="/en/workshop">Workshop</a></li><li><a href="/en/search" aria-current="page">Customers &amp; vehicles</a></li><li><a href="/en/catalogue">Price list</a></li></ul></nav><div class="shell-main"><header class="shell-topbar"><form class="topbar-search" role="search" action="/en/search" method="get"><label for="shell-search" class="visually-hidden">Search customers and vehicles</label><input id="shell-search" type="search" placeholder="Plate, mobile, name or VIN" dir="auto" name="q"/><button type="submit" class="btn btn-secondary">Search</button></form><div class="topbar-user"><span class="who"><span>Sara Test</span><small>Service advisor</small></span><a class="btn btn-quiet" href="/ar/vehicles/abc" hrefLang="ar" lang="ar">العربية</a><form action="/api/auth/logout" method="post"><input type="hidden" name="locale" value="en"/><button type="submit" class="btn btn-quiet">Sign out</button></form></div></header><main class="shell-content"><p>page</p></main></div></div></body></html>"`;
