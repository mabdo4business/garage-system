exports[`S12 — staff app shell > renders the shell in ar with catalog labels, the global search and a same-page language link 1`] = `"<html lang="ar" dir="rtl"><head></head><body><div class="shell"><nav class="shell-nav" aria-label="القائمة الرئيسية"><div class="shell-brand"><span class="mark" aria-hidden="true">ن</span><span class="names"><strong>نظام إدارة الورشة</strong><small>نظام الورشة · الشارقة</small></span></div><ul><li><a href="/ar"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3h7v9H3z M14 3h7v5h-7z M14 12h7v9h-7z M3 16h7v5H3z"></path></svg><span>اليوم</span></a></li><li><a href="/ar/repair-orders"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6v3H9z M7 4.5H5V21h14V4.5h-2 M8 11h8 M8 15h5"></path></svg><span>أوامر الإصلاح</span></a></li><li><a href="/ar/workshop"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h4v16H4z M10 4h4v10h-4z M16 4h4v13h-4z"></path></svg><span>الورشة</span></a></li><li><a href="/ar/parts"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8l-9-5-9 5 9 5 9-5z M3 8v8l9 5 9-5V8 M12 13v8"></path></svg><span>قطع الأعمال</span></a></li><li><a href="/ar/stock"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16v4H4z M4 13h16v4H4z M8 9h.01 M8 15h.01"></path></svg><span>المخزون</span></a></li><li><a href="/ar/search" aria-current="page"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 20v-1a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v1 M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8 M22 20v-1a4 4 0 0 0-3-3.9 M16 3.1a4 4 0 0 1 0 7.8"></path></svg><span>العملاء والمركبات</span></a></li><li><a href="/ar/catalogue"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12l-8 8-9-9V3h8z M7.5 7.5h.01"></path></svg><span>قائمة الأسعار</span></a></li></ul></nav><div class="shell-main"><header class="shell-topbar"><form class="topbar-search" role="search" action="/ar/search" method="get"><label for="shell-search" class="visually-hidden">البحث عن العملاء والمركبات</label><input id="shell-search" type="search" placeholder="رقم اللوحة أو الهاتف أو الاسم أو رقم الهيكل" dir="auto" name="q"/><button type="submit" class="btn btn-secondary">بحث</button></form><div class="topbar-user"><span class="who"><span>Sara Test</span><small>مستشار خدمة</small></span><a class="btn btn-quiet" href="/en/vehicles/abc" hrefLang="en" lang="en">English</a><form action="/api/auth/logout" method="post"><input type="hidden" name="locale" value="ar"/><button type="submit" class="btn btn-quiet">تسجيل الخروج</button></form></div></header><main class="shell-content"><p>page</p></main></div></div></body></html>"`;

