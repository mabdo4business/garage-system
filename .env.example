# Copy to .env and fill in real values. Never commit .env.

# Application connection — uses the least-privileged role (garage_app).
DATABASE_URL=postgres://garage_app:CHANGE_ME@localhost:54329/garage

# Migration connection — uses the owner role (garage_owner). Used only by `npm run db:migrate`.
DATABASE_OWNER_URL=postgres://garage_owner:CHANGE_ME@localhost:54329/garage

# Superuser connection — used only by `npm run db:bootstrap` to create the two roles above.
DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@localhost:54329/postgres

# Passwords assigned to the roles by `npm run db:bootstrap`.
DB_OWNER_PASSWORD=CHANGE_ME
DB_APP_PASSWORD=CHANGE_ME

# Tests: leave unset to use an embedded PostgreSQL started automatically.
# Set to a superuser URL (for example a Docker PostgreSQL on your Mac) to run tests against it instead.
# TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres

# Sessions
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
